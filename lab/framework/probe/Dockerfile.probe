# Multi-stage build: static binary in a minimal runtime image.
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/behinder-probe .

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /out/behinder-probe /usr/local/bin/behinder-probe
ENTRYPOINT ["/usr/local/bin/behinder-probe"]
